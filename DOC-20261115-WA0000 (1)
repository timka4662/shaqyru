<script>
(function(){
var rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
var b=document.body,doors=document.getElementById('doors');
var s=document.getElementById('sparks');
for(var i=0;i<24;i++){var d=document.createElement('i');
d.style.left=(Math.random()*100)+'%';
var z=3+Math.random()*5;d.style.width=d.style.height=z+'px';
d.style.animationDuration=(8+Math.random()*10)+'s';
d.style.animationDelay=(Math.random()*10)+'s';s.appendChild(d);}
var n=document.getElementById('num'),counted=false;
function count(){if(counted||rm)return;counted=true;var t0=null;n.textContent='0';
function f(t){if(!t0)t0=t;var p=Math.min((t-t0)/1800,1);n.textContent=Math.round(50*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f);}
requestAnimationFrame(f);}
var rv=document.querySelectorAll('.rv');
function reveal(){
if(!('IntersectionObserver' in window)){rv.forEach(function(e){e.classList.add('v')});count();return;}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('v');if(e.target.classList.contains('ring'))count();io.unobserve(e.target);}})},{threshold:.15});
rv.forEach(function(e){io.observe(e)});}
function start(){b.classList.remove('lock');reveal();}
if(rm){b.classList.remove('lock');rv.forEach(function(e){e.classList.add('v')});}
else{document.getElementById('openBtn').addEventListener('click',function(){doors.classList.add('open');setTimeout(start,500);setTimeout(function(){doors.style.display='none'},1700);});
n.textContent='0';
var im=document.querySelectorAll('#ph .s'),dt=document.querySelectorAll('#dots i'),k=0;
setInterval(function(){im[k].classList.remove('on');dt[k].classList.remove('on');k=(k+1)%im.length;
void im[k].offsetWidth;im[k].classList.add('on');dt[k].classList.add('on');},4500);}
})();
</script>
