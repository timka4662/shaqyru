<main>
<div class="ring rv">
<svg viewBox="0 0 240 240" fill="none" stroke="#d9b66f" aria-hidden="true">
<circle cx="120" cy="120" r="116" stroke-width="1.6"/>
<g class="g"><circle cx="120" cy="120" r="106" stroke-width=".8" stroke-dasharray="2 6"/><circle cx="120" cy="120" r="93" stroke-width="24" stroke-opacity=".28" stroke-dasharray="1.4 47.4"/></g>
